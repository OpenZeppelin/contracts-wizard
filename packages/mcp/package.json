{
  "name": "@openzeppelin/contracts-mcp",
  "version": "0.6.4",
  "description": "OpenZeppelin Contracts MCP Server",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/OpenZeppelin/contracts-wizard",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/cli.js",
  "ts:main": "src/index.ts",
  "files": [
    "LICENSE",
    "NOTICE",
    "/dist",
    "/src",
    "/apps",
    "!**/*.test.*"
  ],
  "scripts": {
    "build:apps": "yarn --cwd ../ui build:mcp-apps",
    "prepare": "tsc",
    "prepublishOnly": "yarn build:apps",
    "watch": "tsc --watch",
    "test": "ava",
    "test:update-snapshots": "ava --update-snapshots",
    "test:watch": "ava --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openzeppelin/wizard-common": "^0.5.6",
    "@openzeppelin/wizard": "^0.10.13",
    "@openzeppelin/wizard-stylus": "^0.3.0",
    "@openzeppelin/wizard-stellar": "^0.6.4",
    "@openzeppelin/wizard-cairo": "^3.0.0",
    "@openzeppelin/wizard-confidential": "^0.1.2",
    "@openzeppelin/wizard-uniswap-hooks": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ava": "^6.0.0",
    "ts-node": "^10.4.0",
    "typescript": "^5.0.0"
  }
}