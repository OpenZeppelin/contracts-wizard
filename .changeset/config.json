{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "OpenZeppelin/contracts-wizard"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "master",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "changedFilePatterns": [
    "**",
    "!src/cairo_alpha/**",
    "!src/polkadot/**",
    "!api/**",
    "!public/**",
    "!scripts/deno/**",
    "!src/**/App.svelte"
  ],
  "ignore": ["@openzeppelin/wizard-cairo-alpha"]
}
